# Copy to `.env` and adjust as needed. Every value here has a working
# default (see config.py) — this file only needs the lines you actually
# want to override. Real process env vars always take precedence over
# `.env` (see config.py's `load_dotenv(..., override=False)`).

# --- Vault location ---
# VAULT_PATH=../vault

# --- Ollama ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.1:8b
# Model for relatedness judgments (deciding which existing concepts a new
# draft should link to). Defaults to OLLAMA_CHAT_MODEL — override to a
# smaller/cheaper local model to keep ingest fast as the vault grows.
# OLLAMA_RELATEDNESS_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_VISION_MODEL=llava
# OLLAMA_TIMEOUT_SECONDS=300
# OLLAMA_MAX_PREDICT_TOKENS=2048
# OLLAMA_MAX_RETRIES=3
# OLLAMA_RETRY_BACKOFF_SECONDS=1

# --- Local storage (derived/rebuildable — see docs/reference/configuration.md) ---
# CHROMA_DIR=.data/chroma
# SQLITE_PATH=.data/metadata.db
# SCHEMAS_DIR=schemas
# EVALS_DIR=evals
# PARSED_IMAGES_DIR=.data/parsed-images

# --- Ingestion tuning ---
# CHUNK_MAX_CHARS=4000
# DISAMBIGUATION_CONFIDENCE_THRESHOLD=0.75
# EVAL_THRESHOLD=0.7
# Minimum vector-search similarity score (0.0-1.0) a candidate must clear
# before it's even offered to the relatedness skill for judgment. Keeps a
# sparsely-populated vault from surfacing weak/unrelated matches.
# RELATEDNESS_MIN_SCORE=0.5

# --- Logging ---
# LOG_LEVEL=INFO

# --- MCP server ---
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_STATELESS=true
# Set this to require `Authorization: Bearer <token>` on every MCP request.
# Leave unset for local/localhost-only use.
# MCP_AUTH_TOKEN=
